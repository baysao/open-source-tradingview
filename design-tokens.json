        "$value": "{primitive.graphite.raised}"
      },
      "sunken": {
        "$type": "color",
        "$value": "{primitive.graphite.bg}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.graphite.text}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.graphite.dim}",
        "$description": "Secondary text, hints, placeholders. Not on raised in light."
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.graphite.dim}",
        "$description": "faint is decoration only, never text."
      },
      "on-action": {
        "$type": "color",
        "$value": "{primitive.graphite.accentInk}"
