    "action": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.graphite.accent}"
      },
      "danger": {
        "$type": "color",
        "$value": "{primitive.graphite.bad}",
        "$description": "Destructive: border, icon and tinted fill; label stays semantic.text.primary."
      }
    },
    "feedback": {
      "success": {
        "$type": "color",
        "$value": "{primitive.graphite.ok}"
      },
      "error": {
        "$type": "color",
        "$value": "{primitive.graphite.bad}",
        "$description": "Icons and borders. Error text uses semantic.text.primary with the word Error:."
      },
      "warning": {
        "$type": "color",
        "$value": "{primitive.graphite.accent}"
      }
    },
    "market": {
      "up": {
        "$type": "color",
        "$value": "{primitive.graphite.up}"
      },
      "down": {
        "$type": "color",
        "$value": "{primitive.graphite.down}"
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "\"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "\"Cascadia Mono\", Consolas, \"SFMono-Regular\", monospace"
      }
    },
    "size": {
