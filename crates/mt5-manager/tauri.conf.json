{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BridgeManager",
  "version": "0.3.0",
  "identifier": "com.vtradingview.bridgemanager",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["manager"]
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
