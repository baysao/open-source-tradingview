{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeX",
  "version": "0.1.0",
  "identifier": "com.vtradingview.tradex",
  "build": {
    "frontendDist": "icons"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["hub"]
    },
    "windows": [],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vtradingview"]
      }
    }
  }
}
