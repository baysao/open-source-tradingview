# Copy to .env and edit. .env is ignored by git: never commit it.
# Nothing here is needed for the free feeds (Deriv, Bybit, Binance) in local mode.

# --- Server (hub-server always binds 127.0.0.1) ---
HUB_HTTP_PORT=8770
FEED_MAX_SYMBOLS=400

# --- Mode. false = local mode: no sign-in, no database (D-001). ---
AUTH_ENABLED=false
# Required when AUTH_ENABLED=true: the site's https origin, e.g. https://vtradingview.com
PUBLIC_ORIGIN=

# --- Hosted mode (AUTH_ENABLED=true): every value below is required unless marked optional ---
# The account database: pgsqlite (scripts/dev.sh _svc db) or Postgres.
DATABASE_URL=postgres://postgres@127.0.0.1:55432/main?sslmode=disable
# Google OAuth client (Google Cloud console, "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random bytes, base64url, for example:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
VTV_SECRET_KEY=
# Optional: comma-separated Google account emails that may open /admin/*.
ADMIN_EMAILS=

# --- Dev database process (scripts/dev.sh _svc db) ---
PGSQLITE_PORT=55432
# Optional: the pgsqlite binary; default ~/.local/bin/pgsqlite
PGSQLITE_BIN=

# --- Log panel (local mode): extra local log files to show, name=path;name2=path2 ---
HUB_TAIL_FILES=
