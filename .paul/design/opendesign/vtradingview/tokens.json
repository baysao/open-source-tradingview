  "font": {
    "family": {
      "system": {
        "$type": "fontFamily",
        "$value": "\"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif"
      },
      "nunito": {
        "$type": "fontFamily",
        "$value": "\"Nunito\", \"Segoe UI\", sans-serif"
