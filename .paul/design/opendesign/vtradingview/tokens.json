{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "TradeX hub theme as DTCG tokens. Generated from hub/theme.js (HubPresets, HubFonts, HubThemeApply). theme.js stays the runtime source of truth; users may override any colour key, so --onAccent is derived at run time.",
  "preset": {
    "graphite": {
      "$description": "graphite (dark)",
      "bg": {
        "$type": "color",
        "$value": "#151412"
      },
      "panel": {
        "$type": "color",
        "$value": "#1b1a17"
      },
      "raised": {
        "$type": "color",
        "$value": "#24221e"
      },
      "line": {
        "$type": "color",
        "$value": "#2f2c27"
      },
      "grid": {
        "$type": "color",
        "$value": "#1f1d1a"
      },
      "text": {
        "$type": "color",
        "$value": "#e6dfd2"
      },
      "dim": {
        "$type": "color",
        "$value": "#958c7e"
      },
      "faint": {
        "$type": "color",
        "$value": "#5e584f"
      },
      "accent": {
        "$type": "color",
        "$value": "#e3a33a"
      },
      "accentInk": {
        "$type": "color",
        "$value": "#1a1407"
