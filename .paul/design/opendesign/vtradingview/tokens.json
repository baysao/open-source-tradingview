        "$type": "color",
        "$value": "#8fb36a"
      },
      "bad": {
        "$type": "color",
        "$value": "#c9553c"
      },
      "onAccent": {
        "$type": "color",
        "$value": "{preset.graphite.accentInk}",
        "$description": "Whichever of accentInk and text contrasts more with accent. Label colour on primary buttons."
      }
    },
    "black": {
